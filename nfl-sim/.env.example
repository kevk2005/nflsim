# nfl-sim environment variables. Copy to .env and fill in; .env is git-ignored.

# --- Odds feed (nflsim.odds_feed) ---
# The Odds API key (paid plan). Read by nflsim.odds_feed; never printed or logged.
ODDS_API_KEY=

# Monthly credit caps by category (calendar month, UTC). The reserve is never spent
# automatically: calls are refused if remaining credits would drop below it.
ODDS_CAP_LINES=2000
ODDS_CAP_PROPS=16000
ODDS_RESERVE=2000

# One-time historical backfill approval, "YYYY-MM:CAP". Historical calls are allowed
# only in that UTC month, only via `backfill`/`check-books --confirm`, and only until
# the approved backfill completes. Leave empty to keep the historical endpoint off.
# Approved revision: 2026 season to date, cap 14,000 in 2026-10 -> ODDS_HISTORICAL_APPROVAL=2026-10:14000
ODDS_HISTORICAL_APPROVAL=

# --- Simulator switches (read by the code) ---
# 1 = reproduce the old coarse late-game states (for before/after comparisons only).
# 0 or unset = current score-situation x time states (default).
NFLSIM_COARSE_LATE=0
